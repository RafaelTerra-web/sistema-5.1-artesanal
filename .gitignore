# Publicacao por lista de permissao: estado local e downloads ficam fora do Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/docs/
!/docs/**
!/scripts/
!/scripts/**
!/examples/
!/examples/**
!/.github/
!/.github/**
!/configuracao-pc/
/configuracao-pc/*
!/configuracao-pc/*.ps1
!/configuracao-pc/*.cmd
!/configuracao-pc/*.cs
!/configuracao-pc/*.py
!/configuracao-pc/*.js
!/configuracao-pc/*.cjs
!/configuracao-pc/*.html
!/configuracao-pc/*.conf
/configuracao-pc/mpv-sistema-dolby.conf
/configuracao-pc/mpv-sistema-dolby-baixa-latencia.conf
!/configuracao-pc/*.md
!/configuracao-pc/delay-5.1-70ms.txt
!/configuracao-pc/upmix-sistema-5.1.txt

!/configuracao-pc/controle-remoto/
/configuracao-pc/controle-remoto/*
!/configuracao-pc/controle-remoto/*.mjs
!/configuracao-pc/controle-remoto/*.ps1
!/configuracao-pc/controle-remoto/*.cs
!/configuracao-pc/controle-remoto/*.md
!/configuracao-pc/controle-remoto/web/
!/configuracao-pc/controle-remoto/web/**
!/configuracao-pc/controle-remoto/extension/
/configuracao-pc/controle-remoto/extension/*
!/configuracao-pc/controle-remoto/extension/*.js
!/configuracao-pc/controle-remoto/extension/manifest.json

!/configuracao-pc/netflix-dolby51-automatico/
/configuracao-pc/netflix-dolby51-automatico/*
!/configuracao-pc/netflix-dolby51-automatico/*.py
!/configuracao-pc/netflix-dolby51-automatico/*.md

!/configuracao-pc/youtube-dolby51-extensao/
/configuracao-pc/youtube-dolby51-extensao/*
!/configuracao-pc/youtube-dolby51-extensao/*.js
!/configuracao-pc/youtube-dolby51-extensao/manifest.json
!/configuracao-pc/youtube-dolby51-extensao/*.md

!/configuracao-pc/auditoria-deriva-20261003/
/configuracao-pc/auditoria-deriva-20261003/*
!/configuracao-pc/auditoria-deriva-20261003/*.py

!/pesquisa/
/pesquisa/*
!/pesquisa/viabilidade-firmware-ud851b.md

# Protecoes adicionais, inclusive para novas pastas de documentacao/testes.
**/node_modules/
**/__pycache__/
**/*.pyc
**/*.exe
**/*.dll
**/*.zip
**/*.bin
**/*.db
**/*.sqlite*
**/*.log*
**/*.pid
**/*.wav
**/*.raw
**/*.spdif
**/.env*
**/connection-private.json
**/connection.json
**/backup-cadmiumconfig-*.json
**/estado.json
**/endereco.txt
**/Cookies*
**/Login Data*
**/Local State
