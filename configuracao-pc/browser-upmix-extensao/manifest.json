{
  "manifest_version": 3,
  "name": "Sistema 5.1 — Upmix por fonte",
  "version": "0.1.0",
  "description": "Upmix de mono/estéreo antes do mixer; áudio de seis canais permanece nativo.",
  "content_scripts": [
    {"matches": ["https://www.youtube.com/*"], "js": ["page.js"], "run_at": "document_idle", "world": "MAIN"},
    {"matches": ["https://www.youtube.com/*"], "js": ["bootstrap.js"], "run_at": "document_idle"}
  ],
  "web_accessible_resources": [
    {"resources": ["source-worklet.js"], "matches": ["https://www.youtube.com/*"]}
  ]
}
